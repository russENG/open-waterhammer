{
  "name": "@open-waterhammer/runner",
  "version": "0.2.0-alpha.1",
  "description": "Common local calculation runner and engine adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --import tsx/esm src/__tests__/*.test.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@open-waterhammer/contracts": "0.2.0-alpha.1",
    "@open-waterhammer/epanet-adapter": "*",
    "@open-waterhammer/workspace": "0.2.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.21.0"
  }
}
