{
  "name": "@open-waterhammer/contracts",
  "version": "0.2.0-alpha.1",
  "description": "Canonical cross-runtime contracts for Open Waterhammer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "generate:validators": "node --import tsx/esm scripts/generate-validators.ts",
    "build": "npm run generate:validators && tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --import tsx/esm src/__tests__/*.test.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12"
  }
}
